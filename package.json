{
	"name": "advent-of-svelte",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"dev": "vite",
		"dev:expose": "vite --host",
		"build": "vite build",
		"preview": "vite preview",
		"deps:install": "pnpm i",
		"deps:update": "pnpm up",
		"deps:update-latest": "pnpm up -L",
		"check": "svelte-kit sync && svelte-check",
		"check:watch": "svelte-kit sync && svelte-check --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"prepare": "husky"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^0.577.0",
		"@neoconfetti/svelte": "^2.2.2",
		"@sveltejs/adapter-vercel": "^5.10.3",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/table-core": "^8.21.3",
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/eslint-config-prettier": "^6.11.3",
		"@unovis/svelte": "^1.6.7",
		"@vercel/speed-insights": "^1.3.1",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^16.5.0",
		"husky": "^9.1.7",
		"mode-watcher": "^1.1.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"svelte-dnd-action": "^0.9.79",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^2.1.0",
		"tailwindcss": "^4.3.3",
		"tslib": "^2.8.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.69.0",
		"vite": "^7.3.6",
		"vite-plugin-devtools-json": "^1.1.0",
		"vite-plugin-lucide-preprocess": "^1.5.4"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@tailwindcss/oxide",
			"@vercel/speed-insights",
			"esbuild",
			"maplibre-gl"
		]
	},
	"type": "module",
	"packageManager": "pnpm@10.34.5"
}
